# syntax=docker/dockerfile:1.7
# API, Celery worker and beat share this image. The crawler gets its own image in Phase 3.
FROM python:3.12.16-slim-trixie AS build
ENV PIP_NO_CACHE_DIR=1 PIP_DISABLE_PIP_VERSION_CHECK=1
WORKDIR /src
COPY pyproject.toml README.md ./
# Exact versions of every Python package (requirements/constraints.txt): the same build every time.
COPY requirements/constraints.txt ./
COPY common common
COPY database database
COPY ai_providers ai_providers
COPY classification classification
COPY crawler crawler
COPY integrations integrations
COPY feeds feeds
COPY threats threats
COPY backend backend
RUN python -m venv /opt/venv && /opt/venv/bin/pip install -c constraints.txt .

FROM python:3.12.16-slim-trixie
ENV PATH=/opt/venv/bin:$PATH PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
RUN groupadd --system --gid 10001 app && useradd --system --uid 10001 --gid app --home /app --shell /usr/sbin/nologin app
# Celery beat keeps its last-run times here (a named volume), so restarts do not reset the schedule.
RUN install -d -o 10001 -g 10001 -m 0750 /var/lib/celery-beat
COPY --from=build /opt/venv /opt/venv
WORKDIR /app
COPY alembic.ini ./
USER 10001:10001
EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=5s --retries=3 CMD python -c "import urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:8000/healthz', timeout=3).status == 200 else 1)"
CMD ["uvicorn", "backend.app.main:app", "--host", "0.0.0.0", "--port", "8000", "--proxy-headers", "--no-server-header"]
