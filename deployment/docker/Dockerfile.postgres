# syntax=docker/dockerfile:1.7
# The official PostgreSQL image, with Alpine's newest package fixes and gosu rebuilt with a current Go. gosu only
# drops root to the postgres user at start-up; the official entrypoint is unchanged. When the CVE watch reports Go
# or Alpine findings here again, raise the Go version or rebuild (`make up` pulls nothing pinned below by itself).
FROM golang:1.27.3-alpine3.24 AS gosu
RUN apk add --no-cache git
WORKDIR /src
# gosu 1.20, pinned by commit
RUN git init -q . && git fetch -q --depth 1 https://github.com/tianon/gosu.git 29b939aa5bd4dc588af765b8248f6e39150d2565 \
    && git checkout -q FETCH_HEAD
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /gosu . && /gosu --version

FROM postgres:18.7-alpine
RUN apk upgrade --no-cache
COPY --from=gosu /gosu /usr/local/bin/gosu
