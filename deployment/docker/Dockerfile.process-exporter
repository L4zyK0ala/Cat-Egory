# syntax=docker/dockerfile:1.7
# process-exporter 0.8.7 (MIT, https://github.com/ncabatoff/process-exporter) built from source: its last release
# (April 2025) was built with Go 1.23 and old golang.org/x modules. Same layout as upstream's image (scratch, one
# static binary). Module versions below are the first fixed ones the CVE watch named; raise them when it asks.
# x/crypto and x/text match what x/net v0.62.0 requires (go get refuses lower pins).
FROM golang:1.27.3-alpine3.24 AS build
RUN apk add --no-cache git
WORKDIR /src
RUN git init -q . && git fetch -q --depth 1 https://github.com/ncabatoff/process-exporter.git e52ab0a1c03d6baf8ed60154c254ecc0008549f3 \
    && git checkout -q FETCH_HEAD
RUN go get golang.org/x/net@v0.62.0 golang.org/x/crypto@v0.58.0 golang.org/x/text@v0.43.0 golang.org/x/oauth2@v0.27.0 \
    && go mod tidy
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /process-exporter ./cmd/process-exporter \
    && /process-exporter -version

FROM scratch
COPY --from=build /process-exporter /bin/process-exporter
USER 65534:65534
EXPOSE 9256
ENTRYPOINT ["/bin/process-exporter"]
