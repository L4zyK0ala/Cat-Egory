# Installed by `make backup-timer`, which fills in the repository path.
[Unit]
Description=Cat-egory backup (PostgreSQL dump and object store)
Wants=docker.service
After=docker.service

[Service]
Type=oneshot
Environment=HOME=/root
Environment=BACKUP_COPY_TO=/mnt/yedek/cat-egory
Environment=BACKUP_COPY_OPTIONAL=/mnt/yedek-usb/cat-egory
ExecStart=@ROOT@/deployment/scripts/backup.sh
Nice=10
IOSchedulingClass=idle
