# /etc/cat-egory/container-guard.env (deployment/scripts/container-guard.sh). After a change:
#   sudo systemctl restart container-guard
# audit: log what would be blocked (journalctl -k -g container-guard), block nothing. enforce: refuse it.
GUARD_MODE=audit
# Published host ports containers may still open, space-separated (e.g. "8090" when Cat-egory's worker reaches
# Octryx at http://192.168.19.91:8090).
ALLOW_PUBLISHED=""
# The router's DNS: one of the resolvers Docker hands to containers here.
LAN_DNS="192.168.19.1"
