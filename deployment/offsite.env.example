# Off-site backup target for deployment/scripts/offsite-backup.sh (restic).
# Copy to /etc/cat-egory/offsite.env, fill in, then: sudo chown root:root /etc/cat-egory/offsite.env
#                                                   sudo chmod 600 /etc/cat-egory/offsite.env
# Values without quotes (docker --env-file). Never commit the filled-in file. The encryption password is a separate
# file (/etc/cat-egory/offsite.password, created by `make offsite-init`), not this one.

# --- Cloudflare R2 (recommended: 10 GB free, no download fees) --------------------------------------------
# R2 > Create bucket "cat-egory-backup" (location: Eastern Europe), then Manage API tokens > Create token:
# permission "Object Read & Write", applied to that bucket only.
RESTIC_REPOSITORY=s3:https://ACCOUNT_ID.r2.cloudflarestorage.com/cat-egory-backup
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto

# --- Backblaze B2 (S3 API) instead ------------------------------------------------------------------------
# RESTIC_REPOSITORY=s3:https://s3.eu-central-003.backblazeb2.com/cat-egory-backup
# AWS_ACCESS_KEY_ID=<keyID>
# AWS_SECRET_ACCESS_KEY=<applicationKey>

# --- Another machine over SSH: not wired up yet (the container would need an SSH key) ---------------------
# RESTIC_REPOSITORY=sftp:backup@host.example:/srv/restic/cat-egory
