{
 "uid": "cat-egory-overview",
 "title": "Cat-egory overview",
 "schemaVersion": 39,
 "version": 1,
 "time": {
  "from": "now-24h",
  "to": "now"
 },
 "refresh": "1m",
 "panels": [
  {
   "type": "stat",
   "title": "Domains",
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "sum(category_domains)",
     "refId": "A"
    }
   ]
  },
  {
   "type": "stat",
   "title": "Verified",
   "gridPos": {
    "x": 4,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "category_domains{status=\"verified\"}",
     "refId": "A"
    }
   ]
  },
  {
   "type": "stat",
   "title": "Open reviews",
   "gridPos": {
    "x": 8,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "category_open_reviews",
     "refId": "A"
    }
   ]
  },
  {
   "type": "stat",
   "title": "Pending moderation",
   "gridPos": {
    "x": 12,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "category_pending_submissions",
     "refId": "A"
    }
   ]
  },
  {
   "type": "stat",
   "title": "Active threats",
   "gridPos": {
    "x": 16,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "category_active_threats",
     "refId": "A"
    }
   ]
  },
  {
   "type": "stat",
   "title": "Feed age",
   "gridPos": {
    "x": 20,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "category_feed_age_seconds",
     "refId": "A"
    }
   ]
  },
  {
   "type": "timeseries",
   "title": "Scan queue",
   "gridPos": {
    "x": 0,
    "y": 4,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "category_scan_jobs{status=~\"queued|running\"}",
     "legendFormat": "{{status}}",
     "refId": "A"
    }
   ]
  },
  {
   "type": "timeseries",
   "title": "Scan outcomes (cumulative)",
   "gridPos": {
    "x": 12,
    "y": 4,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "category_scan_jobs{status=~\"succeeded|blocked|failed\"}",
     "legendFormat": "{{status}}",
     "refId": "A"
    }
   ]
  },
  {
   "type": "timeseries",
   "title": "API requests / s",
   "gridPos": {
    "x": 0,
    "y": 12,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "reqps"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "sum by (status) (rate(category_http_requests_total[5m]))",
     "legendFormat": "{{status}}",
     "refId": "A"
    }
   ]
  },
  {
   "type": "timeseries",
   "title": "API latency p95",
   "gridPos": {
    "x": 12,
    "y": 12,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "histogram_quantile(0.95, sum by (le, route) (rate(category_http_request_seconds_bucket[5m])))",
     "legendFormat": "{{route}}",
     "refId": "A"
    }
   ]
  },
  {
   "type": "timeseries",
   "title": "AI predictions (24 h) by validation",
   "gridPos": {
    "x": 0,
    "y": 20,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "category_ai_predictions_24h",
     "legendFormat": "{{status}}",
     "refId": "A"
    }
   ]
  },
  {
   "type": "timeseries",
   "title": "Domains by status",
   "gridPos": {
    "x": 12,
    "y": 20,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "category_domains",
     "legendFormat": "{{status}}",
     "refId": "A"
    }
   ]
  }
 ],
 "tags": [
  "cat-egory"
 ]
}