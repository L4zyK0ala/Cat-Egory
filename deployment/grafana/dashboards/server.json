  {
   "type": "timeseries",
   "title": "CPU by kind (100 % = all cores)",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 10,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percent",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 60,
      "showPoints": "never",
      "spanNulls": true,
      "stacking": {
       "mode": "normal",
       "group": "A"
      }
     },
     "color": {
      "mode": "palette-classic"
     },
     "min": 0,
     "max": 100
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "showLegend": true
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "targets": [
    {
     "expr": "100 * sum by (mode) (rate(node_cpu_seconds_total{mode!=\"idle\"}[5m])) / scalar(count(node_cpu_seconds_total{mode=\"idle\"}))",
     "refId": "A",
     "legendFormat": "{{mode}}"
    }
   ],
   "description": "user: programs; system: the kernel; iowait: waiting for disks; softirq: network.",
   "id": 17
  },
  {
   "type": "timeseries",
   "title": "Load average",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 10,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 0,
      "showPoints": "never",
      "spanNulls": true,
      "stacking": {
       "mode": "none",
       "group": "A"
      }
     },
     "color": {
      "mode": "palette-classic"
     }
    },
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "cores"
      },
      "properties": [
       {
        "id": "custom.lineStyle",
        "value": {
         "fill": "dash",
         "dash": [
          10,
          10
         ]
        }
       },
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "red"
        }
       }
      ]
     }
    ]
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "showLegend": true
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "targets": [
    {
     "expr": "node_load1",
     "refId": "A",
     "legendFormat": "1 min"
    },
    {
     "expr": "node_load5",
     "refId": "B",
     "legendFormat": "5 min"
    },
    {
     "expr": "node_load15",
     "refId": "C",
     "legendFormat": "15 min"
    },
    {
