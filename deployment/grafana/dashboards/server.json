{
 "uid": "cat-egory-server",
 "title": "Server",
 "description": "The host Cat-egory runs on (shared with other projects).",
 "schemaVersion": 39,
 "version": 1,
 "time": {
  "from": "now-24h",
  "to": "now"
 },
 "refresh": "1m",
 "panels": [
  {
   "type": "row",
   "title": "Now",
   "collapsed": false,
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 24,
    "h": 1
   },
   "panels": [],
   "id": 1
  },
  {
   "type": "stat",
   "title": "CPU busy",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 1,
    "w": 3,
    "h": 4
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percent",
     "color": {
      "mode": "thresholds"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "orange",
        "value": 75
       },
       {
        "color": "red",
        "value": 90
       }
      ]
     },
     "decimals": 0
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "value",
    "graphMode": "area",
    "textMode": "auto",
    "justifyMode": "auto"
   },
   "targets": [
    {
     "expr": "100 * (1 - avg(rate(node_cpu_seconds_total{mode=\"idle\"}[5m])))",
     "refId": "A"
    }
   ],
   "id": 2
  },
  {
   "type": "stat",
   "title": "Load / cores",
