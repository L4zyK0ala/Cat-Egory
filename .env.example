# Cat-egory configuration template. Copy to .env (git-ignored) or run deployment/scripts/generate-env.sh.
# NEVER put real secrets in this file — it is committed to the repository.

# --- infrastructure secrets (generate-env.sh fills these with random values) ---
POSTGRES_USER=category
POSTGRES_DB=category
POSTGRES_PASSWORD=
REDIS_PASSWORD=
S3_ACCESS_KEY=
S3_SECRET_KEY=
GRAFANA_ADMIN_PASSWORD=
# keyed hash for client IP fingerprints (rate limiting, audit); raw IPs are never stored
CATEGORY_FINGERPRINT_SECRET=

# --- published ports ---
# Public API bind address. 127.0.0.1 = this machine only; set to the server's LAN IP to reach it remotely.
CATEGORY_PUBLIC_BIND=127.0.0.1
CATEGORY_API_PORT=8110
# Prometheus / Grafana bind address (keep private; use an SSH tunnel or a LAN IP).
CATEGORY_ADMIN_BIND=127.0.0.1
PROMETHEUS_PORT=9091
GRAFANA_PORT=3011

# --- application ---
CATEGORY_ENVIRONMENT=development
CATEGORY_LOG_LEVEL=INFO
# mock = offline keyword matcher (never auto-approved). evren = EVREN LLM gateway (needs a key below).
CATEGORY_AI_PROVIDER=mock
# requests per minute: anonymous reads, anonymous writes, API keys (per key, unless set on the key)
CATEGORY_PUBLIC_RATE_LIMIT_PER_MINUTE=60
CATEGORY_ANONYMOUS_WRITE_LIMIT_PER_MINUTE=10
CATEGORY_API_KEY_RATE_LIMIT_PER_MINUTE=600

# --- EVREN LLM gateway (https://evren.ssyz.org.tr/) ---
CATEGORY_EVREN_BASE_URL=https://evren-llmapi.ssyz.org.tr
# Use a key issued for THIS project. Do not reuse another application's key (EVREN terms forbid key sharing).
CATEGORY_EVREN_API_KEY=
CATEGORY_EVREN_MODEL=qwen3.8-flash-next
# response_format=json_object is not verified on the gateway yet; keep false until tested.
CATEGORY_EVREN_JSON_MODE=false
