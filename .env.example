# Cat-egory configuration template. Copy to .env (git-ignored) or run deployment/scripts/generate-env.sh.
# NEVER put real secrets in this file — it is committed to the repository.

# --- infrastructure secrets (generate-env.sh fills these with random values) ---
POSTGRES_USER=category
POSTGRES_DB=category
POSTGRES_PASSWORD=
REDIS_PASSWORD=
S3_ACCESS_KEY=
S3_SECRET_KEY=
GRAFANA_ADMIN_PASSWORD=
# keyed hash for client IP fingerprints (rate limiting, audit); raw IPs are never stored
CATEGORY_FINGERPRINT_SECRET=
# shared secret that marks refusals coming from the egress proxy (sites cannot forge them)
CATEGORY_EGRESS_PROXY_TOKEN=

# --- published ports ---
# Public API bind address. 127.0.0.1 = this machine only; set to the server's LAN IP to reach it remotely.
CATEGORY_PUBLIC_BIND=127.0.0.1
CATEGORY_API_PORT=8110
# web UI port, the API address browsers use, and the UI origin allowed to call the API (JSON list)
CATEGORY_WEB_PORT=3010
CATEGORY_PUBLIC_API_URL=http://127.0.0.1:8110
CATEGORY_CORS_ORIGINS=["http://127.0.0.1:3010"]
# optional service key so server-side page renders are not limited like anonymous visitors
# (python -m backend.cli create-key ... --rate-limit 6000)
CATEGORY_FRONTEND_API_KEY=
# Prometheus / Grafana bind address (keep private; use an SSH tunnel or a LAN IP).
CATEGORY_ADMIN_BIND=127.0.0.1
# Admin API and admin UI listen only on CATEGORY_ADMIN_BIND (keep it private: localhost, LAN or VPN).
CATEGORY_ADMIN_API_PORT=8111
CATEGORY_ADMIN_WEB_PORT=3012
CATEGORY_ADMIN_API_URL=http://127.0.0.1:8111
CATEGORY_ADMIN_CORS_ORIGINS=["http://127.0.0.1:3012"]
PROMETHEUS_PORT=9091
GRAFANA_PORT=3011

# --- application ---
CATEGORY_ENVIRONMENT=development
CATEGORY_LOG_LEVEL=INFO
# mock = offline keyword matcher (never auto-approved). evren = EVREN LLM gateway (needs a key below).
CATEGORY_AI_PROVIDER=mock
# requests per minute: anonymous reads, anonymous writes, API keys (per key, unless set on the key)
CATEGORY_PUBLIC_RATE_LIMIT_PER_MINUTE=60
CATEGORY_ANONYMOUS_WRITE_LIMIT_PER_MINUTE=10
CATEGORY_API_KEY_RATE_LIMIT_PER_MINUTE=600

# --- Certificate-transparency brand watch: look-alike domains queued per hour at most
CATEGORY_CT_WATCH_MAX_PER_HOUR=30
# Protect the top N popular domains against homographs/typos (0 = off)
CATEGORY_LOOKALIKE_TOP_N=1000

# --- Discovery: first scans of domains from approved discovery sources (slow on purpose)
CATEGORY_DISCOVERY_DAILY_BUDGET=200
CATEGORY_DISCOVERY_BATCH_SIZE=10
CATEGORY_DISCOVERY_MAX_QUEUED=20

# --- EVREN LLM gateway (https://evren.ssyz.org.tr/) ---
CATEGORY_EVREN_BASE_URL=https://evren-llmapi.ssyz.org.tr
# Use a key issued for THIS project. Do not reuse another application's key (EVREN terms forbid key sharing).
CATEGORY_EVREN_API_KEY=
CATEGORY_EVREN_MODEL=qwen3.8-flash-next
# One answer takes 25-55 s, sometimes > 2 min. Read timeout per request / total per call incl. waiting.
CATEGORY_EVREN_TIMEOUT_SECONDS=180
CATEGORY_EVREN_DEADLINE_SECONDS=270
CATEGORY_EVREN_MAX_OUTPUT_TOKENS=3000
# response_format=json_object is not verified on the gateway yet; keep false until tested.
CATEGORY_EVREN_JSON_MODE=false
# optional second model for the 0.70-0.89 confidence band (two models must agree)
CATEGORY_EVREN_SECOND_MODEL=

# --- crawler ---
# Chromium runs with its own sandbox; install deployment/apparmor/cat-egory-crawler on the host first
# (documentation/OPERATIONS.md). Weaker fallback: -f deployment/docker-compose.nosandbox.yml

# VirusTotal lookups for reviewers, admin panel only (documentation/THREATS.md). Empty = off.
# Read the terms first: the public API must not be used in commercial products or services.
CATEGORY_VIRUSTOTAL_API_KEY=

# Critical alerts to Telegram (documentation/OPERATIONS.md). Both empty = nothing is sent.
CATEGORY_ALERT_TELEGRAM_TOKEN=
CATEGORY_ALERT_TELEGRAM_CHAT_ID=

# Going public through Cloudflare Tunnel (documentation/OPERATIONS.md): docker compose --profile public up -d
CATEGORY_TUNNEL_TOKEN=

# Shown on /privacy and /contact (the data controller) and in security.txt. Set both before going public.
CATEGORY_CONTACT_EMAIL=
CATEGORY_OPERATOR_NAME=

# Findings from Octryx (threats/octryx.py). The token is Octryx's EXPORT_TOKEN. Empty = off.
CATEGORY_OCTRYX_URL=
CATEGORY_OCTRYX_TOKEN=
